  | "CHURN_LIMIT_QUOTIENT" => (fun x => { c with CHURN_LIMIT_QUOTIENT := x }) <$> natOf v
  | "MAX_PER_EPOCH_ACTIVATION_CHURN_LIMIT" => (fun x => { c with MAX_PER_EPOCH_ACTIVATION_CHURN_LIMIT := x }) <$> natOf v
