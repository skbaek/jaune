  | "MIN_EPOCHS_FOR_BLOB_SIDECARS_REQUESTS" => (fun x => { c with MIN_EPOCHS_FOR_BLOB_SIDECARS_REQUESTS := x }) <$> v.asNat
  | "BLOB_SIDECAR_SUBNET_COUNT" => (fun x => { c with BLOB_SIDECAR_SUBNET_COUNT := x }) <$> v.asNat
  | "MAX_BLOBS_PER_BLOCK" => (fun x => { c with MAX_BLOBS_PER_BLOCK := x }) <$> v.asNat
  | "MAX_REQUEST_BLOB_SIDECARS" => (fun x => { c with MAX_REQUEST_BLOB_SIDECARS := x }) <$> v.asNat
  | "BLOB_SIDECAR_SUBNET_COUNT_ELECTRA" => (fun x => { c with BLOB_SIDECAR_SUBNET_COUNT_ELECTRA := x }) <$> v.asNat
  | "MAX_BLOBS_PER_BLOCK_ELECTRA" => (fun x => { c with MAX_BLOBS_PER_BLOCK_ELECTRA := x }) <$> v.asNat
  | "MAX_REQUEST_BLOB_SIDECARS_ELECTRA" => (fun x => { c with MAX_REQUEST_BLOB_SIDECARS_ELECTRA := x }) <$> v.asNat
  | "NUMBER_OF_CUSTODY_GROUPS" => (fun x => { c with NUMBER_OF_CUSTODY_GROUPS := x }) <$> v.asNat
  | "DATA_COLUMN_SIDECAR_SUBNET_COUNT" => (fun x => { c with DATA_COLUMN_SIDECAR_SUBNET_COUNT := x }) <$> v.asNat
