/-- Apply a case `config.yaml` (a mapping) on top of `base`. -/
def _root_.JauneConsensus.Config.applyOverrides (base : Config) (doc : YVal) :
    Except ConfigError Config :=
  match doc with
  | .map kvs => kvs.foldlM (fun c (k, v) => c.setKey k v) base
  | _ => .error .notMapping

