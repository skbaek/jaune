  | "SUBNETS_PER_NODE" => (fun x => { c with SUBNETS_PER_NODE := x }) <$> v.asNat
  | "ATTESTATION_SUBNET_COUNT" => (fun x => { c with ATTESTATION_SUBNET_COUNT := x }) <$> v.asNat
  | "ATTESTATION_SUBNET_EXTRA_BITS" => (fun x => { c with ATTESTATION_SUBNET_EXTRA_BITS := x }) <$> v.asNat
  | "ATTESTATION_SUBNET_PREFIX_BITS" => (fun x => { c with ATTESTATION_SUBNET_PREFIX_BITS := x }) <$> v.asNat
